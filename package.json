{
  "name": "flyway-actions",
  "author": "Redgate",
  "license": "MIT",
  "workspaces": [
    "list",
    "shared",
    "migrations/**",
    "state/**"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A -p run build",
    "test": "yarn workspaces foreach -A -p run test",
    "lint": "yarn workspaces foreach -A -p run lint",
    "format": "yarn workspaces foreach -A -p run format",
    "format:check": "yarn workspaces foreach -A -p run format:check",
    "download-licenses": "license-checker-rseidelsohn --plainVertical --out third_party_licenses.txt --production --excludePrivatePackages --excludePackagesStartingWith @flyway-actions/"
  },
  "packageManager": "yarn@4.14.1",
  "dependencies": {
    "@flyway-actions/list": "workspace:*",
    "@flyway-actions/migrations-checks": "workspace:*",
    "@flyway-actions/migrations-deploy": "workspace:*",
    "@flyway-actions/migrations-generate": "workspace:*",
    "@flyway-actions/migrations-undo": "workspace:*",
    "@flyway-actions/shared": "workspace:*",
    "@flyway-actions/state-deploy": "workspace:*",
    "@flyway-actions/state-prepare": "workspace:*"
  },
  "devDependencies": {
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "eslint-plugin-import": "2.32.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
